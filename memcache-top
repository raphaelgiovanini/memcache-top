################################################################################
# cache_get
# Connects to memcached instances and retrieves a key's value.
#
sub cache_get {
  my ($instances_ref, $key) = @_;

  foreach my $instance (@$instances_ref) {
    my @split = split(/:/, $instance);
    unless ($split[1]) {
      $instance = $instance . ":" . $default_port;
    }

    my $sock = IO::Socket::INET->new(
      PeerAddr => $instance,
      Timeout  => $connect_timeout,
    );
    unless (defined $sock) {
      print "[$instance] Connection failed\n";
      next;
    }
    $sock->autoflush(1);

    print $sock "get $key\r\n";

    my $found = 0;
    my $value = '';
    my ($flags, $bytes_len) = (0, 0);

    while (defined(my $line = <$sock>)) {
      chomp $line;
      $line =~ s/\r$//;

      if ($line =~ /^VALUE\s+\S+\s+(\d+)\s+(\d+)/) {
        $flags = $1;
        $bytes_len = $2;
        $found = 1;
        next;
      }
      last if $line eq 'END';

      if ($found) {
        $value .= $line;
      }
    }

    close $sock;

    if ($found) {
      print "\n";
      print "  Instance:  $instance\n";
      print "  Key:       $key\n";
      print "  Flags:     $flags\n";
      print "  Size:      $bytes_len bytes\n";
      print "  Value:     $value\n";
      print "\n";
    } else {
      print "[$instance] Key '$key' not found\n";
    }
  }
}

################################################################################
# cache_dump_keys
# Lists keys from memcached instances using 'stats items' + 'stats cachedump'.
#
sub cache_dump_keys {
  my ($instances_ref) = @_;

  foreach my $instance (@$instances_ref) {
    my @split = split(/:/, $instance);
    unless ($split[1]) {
      $instance = $instance . ":" . $default_port;
    }

    my $sock = IO::Socket::INET->new(
      PeerAddr => $instance,
      Timeout  => $connect_timeout,
    );
    unless (defined $sock) {
      print "[$instance] Connection failed\n";
      next;
    }
    $sock->autoflush(1);

    # First get slab IDs via 'stats items'
    print $sock "stats items\r\n";
    my %slabs;
    while (defined(my $line = <$sock>)) {
      chomp $line;
      $line =~ s/\r$//;
      last if $line eq 'END';
      if ($line =~ /^STAT items:(\d+):number\s+(\d+)/) {
        $slabs{$1} = $2;
      }
    }

    if (!%slabs) {
      print "[$instance] No items found (cache is empty)\n";
      close $sock;
      next;
    }

    print "\n  Instance: $instance\n";
    print sprintf("  %-40s  %10s  %s\n", "KEY", "SIZE", "EXPIRY");
    print "  " . ("-" x 70) . "\n";

    my $total_keys = 0;

    foreach my $slab_id (sort { $a <=> $b } keys %slabs) {
      my $limit = $slabs{$slab_id};
      $limit = 200 if $limit > 200;  # cap to avoid flooding

      # Reconnect for each slab dump (some versions need this)
      my $dsock = IO::Socket::INET->new(
        PeerAddr => $instance,
        Timeout  => $connect_timeout,
      );
      next unless defined $dsock;
      $dsock->autoflush(1);

      print $dsock "stats cachedump $slab_id $limit\r\n";

      while (defined(my $line = <$dsock>)) {
        chomp $line;
        $line =~ s/\r$//;
        last if $line eq 'END';
        # Format: ITEM <key> [<size> b; <expiry> s]
        if ($line =~ /^ITEM\s+(\S+)\s+\[(\d+)\s+b;\s+(\d+)\s+s\]/) {
          my ($k, $sz, $exp) = ($1, $2, $3);
          my $exp_str = $exp == 0 ? "never" : scalar(localtime($exp));
          print sprintf("  %-40s  %8s B  %s\n", substr($k, 0, 40), $sz, $exp_str);
          $total_keys++;
        }
      }

      close $dsock;
    }

    print "  " . ("-" x 70) . "\n";
    print "  Total: $total_keys keys listed\n\n";

    close $sock;
  }
}

################################################################################
# interactive_search
# Prompts user for a key name and looks it up in memcached.
#
sub interactive_search {
  my ($instances_ref) = @_;

  # Restore terminal for line input
  system("stty icanon echo 2>/dev/null");

  print "\033[2J\033[H";  # Clear screen
  print "\n  Search cache by key name\n";
  print "  " . ("-" x 40) . "\n";
  print "  Enter key (or empty to cancel): ";

  my $key = <STDIN>;
  chomp $key if defined $key;

  if (!defined $key || $key eq '') {
    return;
  }

  cache_get($instances_ref, $key);

  print "  Press any key to return to monitoring...";
  my $dummy = timed_read_key(30);
}

################################################################################
# interactive_dump
# Shows all cached keys in an interactive overlay.
#
sub interactive_dump {
  my ($instances_ref) = @_;

  print "\033[2J\033[H";  # Clear screen
  print "\n  Listing cached keys...\n\n";

  cache_dump_keys($instances_ref);

  print "  Press any key to return to monitoring...";
  my $dummy = timed_read_key(60);
}

