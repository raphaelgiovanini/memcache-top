#!/usr/bin/perl -w

################################################################################
# memcache-top
#
# "top" for memcache - watch the traffic and other stats in real-time.  Yoikes.
#
# NOTES:
#
#   - Specify instances w/ --instances (multiple times or comma separated)
#   - Specify default port w/ --port (defaults to 11211)
#   - Specify sleep time w/ --sleep (default 3), or as a bare number
#   - Specify color output w/ --color (default) or --nocolor
#   - Specify lifetime stats (averaged over server uptime) w/ --lifetime
#   - Specify read and write bytes columns w/ --bytes or --nobytes (default)
#   - Specify get and set columns w/ --commands (default) or --nocommands
#   - Specify cumulative numbers (since start of run) w/ --cumulative
#   - Run a single time without clearing the screen, good for scripts and
#     monitoring checks: --oneoff.  Exit code is 0 OK, 1 WARNING, 2 CRITICAL.
#
#   Thresholds live in %limit below.  Each metric has a warning (yellow) and
#   a critical (red) level; the ALERTS panel explains what is wrong.
#   Written against memcached v 1.2.3, but works fine w/ later versions.
#
# HISTORY: see HISTORY.rst
#
################################################################################

use strict;
use IO::Socket;
use Time::HiRes qw(time sleep);
use POSIX qw(strftime);
use Getopt::Long;
use Term::ANSIColor;

my $version = "0.8";

################################################################################
# CONFIGURATION

# [warning, critical].  hit_ratio is "lower is worse", everything else higher.
my %limit = (
  evictions => [1, 50],      # evictions per second
  hit_ratio => [80, 50],     # % of gets that hit, only checked above $min_gets
  conn_pct  => [80, 95],     # curr_connections as % of max_connections
  latency   => [50, 250],    # ms for one 'stats' round-trip
  mem       => [90, 98],     # % of limit_maxbytes; color only, a full cache is normal
);
my $min_gets   = 10;         # gets/s below which the hit ratio is just noise
my $warming    = 600;        # seconds of uptime during which the cache is "cold"
my $timeout    = 3;          # seconds to wait on an instance before calling it DOWN

my $usecolor   = 1;
my $lifetime   = 0;
my $bytes      = 0;
my $commands   = 1;
my $cumulative = 0;
my $sleep      = 3;
my $oneoff     = 0;
my $default_port = 11211;
my @default_instances = ('127.0.0.1:11211');

# END CONFIGURATION
################################################################################

my @instances;
GetOptions(
  'instances=s' => \@instances,
  'sleep=i'     => \$sleep,
  'port=i'      => \$default_port,
  'color!'      => \$usecolor,
  'lifetime!'   => \$lifetime,
  'bytes!'      => \$bytes,
  'commands!'   => \$commands,
  'cumulative!' => \$cumulative,
  'oneoff'      => \$oneoff,
) or die "USAGE: memcache-top [--instances h:p,...] [--sleep N] [--oneoff] ...\n";
$sleep = shift @ARGV if @ARGV && $ARGV[0] =~ /^\d+$/;
$sleep = 1 if $sleep < 1;
@instances = @instances ? split(/,/, join(',', @instances)) : @default_instances;
@instances = map { /:\d+$/ ? $_ : "$_:$default_port" } @instances;
$lifetime = 0 if $cumulative;
$usecolor = 0 if $oneoff || !-t STDOUT;

my @counters = qw(cmd_get cmd_set get_hits get_misses evictions bytes_read
                  bytes_written rejected_connections listen_disabled_num);
my @lvlname  = ('OK', 'WARNING', 'CRITICAL');
my @lvlcolor = ('green', 'yellow', 'bold red');

my (%sock, %prev, %first);

$SIG{PIPE} = 'IGNORE';
unless ($oneoff) {
  print "\033[?1049h\033[?25l";                    # alternate screen, hide cursor
  $SIG{INT} = $SIG{TERM} = sub { exit 0 };
}
END { print "\033[?25h\033[?1049l" unless $oneoff }

if ($oneoff) {
  # Rates need two samples; lifetime/cumulative-from-zero don't.
  unless ($lifetime) { sample($_) for @instances; sleep $sleep; }
  my ($frame, $status) = frame();
  print $frame;
  exit $status;
}

while (1) {
  my ($frame) = frame();
  print "\033[H\033[2J", $frame;
  sleep $sleep;
}

################################################################################
# frame: polls every instance, returns (screen text, worst alert level).
#
sub frame {
  my (@rows, @alerts, %tot);
  my $up = 0;

  foreach my $inst (@instances) {
    my $r = sample($inst);
    unless ($r) {
      push @rows, paint(sprintf("%-21s %s", shortname($inst), "DOWN - no response"), 2);
      push @alerts, [2, $inst, "unreachable (connect or 'stats' failed within ${timeout}s)"];
      next;
    }
    $up++;
    push @alerts, map { [$_->[0], $inst, $_->[1]] } check($r);
    push @rows, row($inst, $r);
    $tot{$_} += $r->{$_} // 0
      for qw(bytes limit_maxbytes curr_connections max_connections curr_items
             cmd_get cmd_set get_hits get_misses evictions bytes_read bytes_written);
    $tot{rated}++ if defined $r->{hit};
  }

  my $status = 0;
  $status = $_->[0] > $status ? $_->[0] : $status for @alerts;

  my @o;
  push @o, paint("memcache-top v$version", 'bold')
         . strftime("  %Y-%m-%d %H:%M:%S", localtime)
         . sprintf("  refresh %ds  %s  %d/%d up  ", $sleep, mode(), $up, scalar @instances)
         . paint(" $lvlname[$status] ", $status == 0 ? 'black on_green'
                                      : $status == 1 ? 'black on_yellow' : 'bold white on_red')
         . "\n\n";

  # htop-style meters for the whole cluster.
  my $mem = $tot{limit_maxbytes} ? 100 * $tot{bytes} / $tot{limit_maxbytes} : 0;
  my $gets = $tot{rated} ? $tot{get_hits} + $tot{get_misses} : 0;
  my $hit = $gets ? 100 * $tot{get_hits} / $gets : undef;
  my $conn = $tot{max_connections} ? 100 * $tot{curr_connections} / $tot{max_connections} : undef;
  push @o, meter('Mem', $mem, human_bytes($tot{bytes}) . '/' . human_bytes($tot{limit_maxbytes}), level($mem, 'mem'))
         . '  '
         . meter('Hit', $hit, defined $hit ? sprintf('%.1f%%', $hit) : 'n/a', $gets && $tot{cmd_get} >= $min_gets ? level($hit, 'hit_ratio', 1) : 0)
         . "\n";
  push @o, meter('Con', $conn, ($tot{curr_connections} // 0) . ($tot{max_connections} ? "/$tot{max_connections}" : ''), level($conn, 'conn_pct'))
         . '  '
         . sprintf(" Items %s  Get %s  Set %s  Evict %s  Rx %s  Tx %s",
                   human_num($tot{curr_items}), unit(human_num($tot{cmd_get})), unit(human_num($tot{cmd_set})),
                   unit(human_num($tot{evictions})), unit(human_bytes($tot{bytes_read})), unit(human_bytes($tot{bytes_written})))
         . "\n\n";

  my $s = $cumulative ? '' : '/s';
  my $head = sprintf("%-21s %6s %6s %6s", 'INSTANCE', 'UPTIME', 'MEM%', 'HIT%');
  $head .= sprintf(" %7s %7s", "GET$s", "SET$s") if $commands;
  $head .= sprintf(" %8s %10s %7s", "EVICT$s", 'CONN', 'LAT');
  $head .= sprintf(" %7s %7s", "RX$s", "TX$s") if $bytes;
  push @o, paint(sprintf("%-*s", length($head) + 1, $head), 'black on_green'), "\n";
  push @o, map { "$_\n" } @rows;

  push @o, "\n", paint(sprintf("ALERTS (%d)", scalar @alerts), 'bold'), "\n";
  if (@alerts) {
    foreach my $a (sort { $b->[0] <=> $a->[0] } @alerts) {
      push @o, paint(sprintf("  %-4s", $a->[0] == 2 ? 'CRIT' : 'WARN'), $a->[0])
             . sprintf("  %-21s  %s\n", shortname($a->[1]), $a->[2]);
    }
  } else {
    push @o, paint("  No problems detected.", 0), "\n";
  }
  push @o, "\n(ctrl-c to quit)\n" unless $oneoff;

  return (join('', @o), $status);
}

################################################################################
# sample: fetch stats and turn counters into rates (or totals) for one instance.
# Returns undef if the instance is down.
#
sub sample {
  my ($inst) = @_;
  my $s = fetch($inst) or return;
  my $p = $prev{$inst};

  # Counters reset on restart: start over instead of showing negative rates.
  if ($p && ($s->{uptime} // 0) < ($p->{uptime} // 0)) {
    undef $p;
    delete $first{$inst};
  }

  my ($base, $elapsed);
  if ($lifetime) {
    ($base, $elapsed) = ({}, $s->{uptime} || 1);
  } elsif ($cumulative) {
    $first{$inst} ||= $s;
    ($base, $elapsed) = ($first{$inst}, $s->{_time} - $first{$inst}{_time});
  } elsif ($p) {
    ($base, $elapsed) = ($p, $s->{_time} - $p->{_time});
  }
  $prev{$inst} = $s;

  my %r = map { $_ => $s->{$_} }
          qw(uptime bytes limit_maxbytes curr_connections max_connections curr_items _latency);
  return \%r unless $base;

  my %d = map { $_ => ($s->{$_} // 0) - ($base->{$_} // 0) } @counters;
  my $div = $cumulative ? 1 : ($elapsed || 1);
  $r{$_} = $d{$_} / $div for @counters;
  $r{get_rate} = $elapsed ? $d{cmd_get} / $elapsed : 0;
  $r{rejected} = $d{rejected_connections} + $d{listen_disabled_num};
  my $gets = $d{get_hits} + $d{get_misses};
  $r{hit} = $gets ? 100 * $d{get_hits} / $gets : undef;
  $r{rated} = 1;
  return \%r;
}

# fetch: one 'stats' round-trip over a persistent connection, retried once so a
# stale socket (e.g. after a server restart) doesn't show up as DOWN.
sub fetch {
  my ($inst) = @_;
  for (1 .. 2) {
    my %s;
    my $ok = eval {
      local $SIG{ALRM} = sub { die "timeout\n" };
      alarm $timeout;
      $sock{$inst} ||= IO::Socket::INET->new(PeerAddr => $inst, Timeout => $timeout)
        or die "connect\n";
      my $fh = $sock{$inst};
      $fh->autoflush(1);
      my $t0 = time;
      print $fh "stats\r\n" or die "write\n";
      while (defined(my $line = <$fh>)) {
        last if $line =~ /^END/;
        $s{$1} = $2 if $line =~ /^STAT (\S+) (\S+)/;
      }
      die "eof\n" unless %s;
      $s{_latency} = (time - $t0) * 1000;
      alarm 0;
      1;
    };
    alarm 0;
    if ($ok) { $s{_time} = time; return \%s; }
    close $sock{$inst} if $sock{$inst};
    delete $sock{$inst};
  }
  return;
}

################################################################################
# check: the actual "do I have a problem?" logic.  Returns ([level, message]...).
#
sub check {
  my ($r) = @_;
  my @a;
  my $mem = $r->{limit_maxbytes} ? 100 * $r->{bytes} / $r->{limit_maxbytes} : 0;

  if (defined $r->{uptime} && $r->{uptime} < $warming) {
    push @a, [1, sprintf("uptime %s - recently restarted, cache is cold", human_time($r->{uptime}))];
  }
  if (my $l = level($r->{_latency}, 'latency')) {
    push @a, [$l, sprintf("'stats' took %.0fms - server overloaded or network slow", $r->{_latency})];
  }
  if ($r->{max_connections}) {
    my $pct = 100 * $r->{curr_connections} / $r->{max_connections};
    if (my $l = level($pct, 'conn_pct')) {
      push @a, [$l, sprintf("%d/%d connections (%.0f%%) - near max_connections (-c)",
                            $r->{curr_connections}, $r->{max_connections}, $pct)];
    }
  }
  return @a unless $r->{rated};

  if ($r->{rejected} > 0) {
    push @a, [2, "rejecting connections - max_connections reached, clients are failing"];
  }
  if (my $l = level($r->{evictions}, 'evictions')) {
    push @a, [$l, sprintf("evicting %s items%s with memory %.0f%% full - cache too small (-m)",
                          human_num($r->{evictions}), $cumulative ? '' : '/s', $mem)];
  }
  if (defined $r->{hit} && $r->{get_rate} >= $min_gets) {
    if (my $l = level($r->{hit}, 'hit_ratio', 1)) {
      push @a, [$l, sprintf("hit ratio %.1f%% at %s gets/s - most reads go to the backend",
                            $r->{hit}, human_num($r->{get_rate}))];
    }
  }
  return @a;
}

################################################################################
# Display helpers.

sub row {
  my ($inst, $r) = @_;
  my $mem = $r->{limit_maxbytes} ? 100 * $r->{bytes} / $r->{limit_maxbytes} : 0;
  my $hitlvl = defined $r->{hit} && $r->{get_rate} >= $min_gets ? level($r->{hit}, 'hit_ratio', 1) : 0;
  my $conn = ($r->{curr_connections} // 0) . ($r->{max_connections} ? "/$r->{max_connections}" : '');
  my $connlvl = $r->{max_connections} ? level(100 * $r->{curr_connections} / $r->{max_connections}, 'conn_pct') : 0;
  $connlvl = 2 if $r->{rejected};

  my $line = sprintf("%-21s", shortname($inst))
    . cell(6, defined $r->{uptime} ? human_time($r->{uptime}) : '-',
           defined $r->{uptime} && $r->{uptime} < $warming ? 1 : 0)
    . cell(6, sprintf('%.1f', $mem), level($mem, 'mem'))
    . cell(6, defined $r->{hit} ? sprintf('%.1f', $r->{hit}) : '-', $hitlvl);
  $line .= cell(7, human_num($r->{cmd_get})) . cell(7, human_num($r->{cmd_set})) if $commands;
  $line .= cell(8, human_num($r->{evictions}), $r->{rated} ? level($r->{evictions}, 'evictions') : 0)
         . cell(10, $conn, $connlvl)
         . cell(7, sprintf('%.1fms', $r->{_latency}), level($r->{_latency}, 'latency'));
  $line .= cell(7, human_bytes($r->{bytes_read})) . cell(7, human_bytes($r->{bytes_written})) if $bytes;
  return $line;
}

# level: 0 OK, 1 warning, 2 critical.  $low means lower values are worse.
sub level {
  my ($v, $key, $low) = @_;
  return 0 unless defined $v;
  my ($warn, $crit) = @{ $limit{$key} };
  return $low ? ($v < $crit ? 2 : $v < $warn ? 1 : 0)
              : ($v >= $crit ? 2 : $v >= $warn ? 1 : 0);
}

# Pad first, then color, so escape codes don't break the column alignment.
sub cell {
  my ($w, $text, $lvl) = @_;
  return ' ' . paint(sprintf("%*s", $w, $text), $lvl ? $lvl : undef);
}

sub paint {
  my ($text, $style) = @_;
  return $text unless $usecolor && defined $style;
  $style = $lvlcolor[$style] if $style =~ /^\d$/;
  return color($style) . $text . color('reset');
}

# htop-style bar: Mem[|||||||       2.6M/4.0G]
sub meter {
  my ($label, $pct, $text, $lvl) = @_;
  my $w = 30;
  my $fill = defined $pct ? int($w * ($pct > 100 ? 100 : $pct) / 100 + 0.5) : 0;
  $fill = 1 if defined $pct && $pct > 0 && !$fill;
  my $bar = ('|' x $fill) . (' ' x ($w - $fill));
  substr($bar, $w - length($text), length($text), $text) if length($text) < $w;
  my $bars = substr($bar, 0, $fill);
  my $rest = substr($bar, $fill);
  return paint(sprintf("%4s", $label), 'cyan') . '['
       . paint($bars, $lvl ? $lvl : 'green') . $rest . ']';
}

sub shortname {
  my ($inst) = @_;
  return $inst if length($inst) <= 21;
  my ($host, $port) = $inst =~ /^(.*):(\d+)$/;
  return substr($host, 0, 20 - length($port) - 1) . "~:$port";
}

sub mode { $lifetime ? 'lifetime avg' : $cumulative ? 'cumulative' : 'per-second' }

sub unit { $cumulative ? $_[0] : $_[0] eq '-' ? '-' : "$_[0]/s" }

sub human_num {
  my ($v) = @_;
  return '-' unless defined $v;
  return sprintf('%.1f', $v) if $v < 10 && $v != int($v);
  return sprintf('%.0f', $v) if $v < 10000;
  return sprintf('%.1fk', $v / 1e3) if $v < 1e6;
  return sprintf('%.1fM', $v / 1e6) if $v < 1e9;
  return sprintf('%.1fG', $v / 1e9);
}

sub human_bytes {
  my ($v) = @_;
  return '-' unless defined $v;
  my @u = ('B', 'K', 'M', 'G', 'T');
  my $i = 0;
  while ($v >= 1024 && $i < $#u) { $v /= 1024; $i++ }
  return $i ? sprintf('%.1f%s', $v, $u[$i]) : sprintf('%.0fB', $v);
}

sub human_time {
  my ($s) = @_;
  return sprintf('%dd%dh', $s / 86400, $s % 86400 / 3600) if $s >= 86400;
  return sprintf('%dh%dm', $s / 3600, $s % 3600 / 60) if $s >= 3600;
  return sprintf('%dm%ds', $s / 60, $s % 60) if $s >= 60;
  return sprintf('%ds', $s);
}
################################################################################
