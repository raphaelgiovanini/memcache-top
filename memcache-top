#!/usr/bin/perl -w

################################################################################
# memcache-top
#
# "top" for memcache - watch the traffic and other stats in real-time.
#
# Run with --help for full usage information.
#
################################################################################

use strict;
use IO::Socket;
use Time::HiRes 'time';

my (@default_instances, @instances, $remote, $sleep, %threshold, %laststats,
    $usecolor, @keys, $default_port, $version, @out, $lifetime, $bytes,
    $commands, $cumulative, $oneoff, $sort_by, $help, $connect_timeout,
    $get_key, $dump_keys);

$version = "1.1";

################################################################################
# CONFIGURATION

# Set $usecolor to 1 to enable color output.
$usecolor = 1;

# 'Alert' threshold values at which to color the text red.
%threshold = (
    cache_hit       => 60,       # Cache hit ratio (alert if below)
    usage           => 90,       # % space used (alert if above)
    time            => 5,        # Number of ms to run the stats query
    curr_items      => 0,        # Number of items
    evictions       => 0,        # Number of evictions per second
    curr_connections => 3500,    # Number of current connections
    bytes_read      => 1000000,  # Bytes read, per second
    bytes_written   => 1000000,  # Bytes written, per second
    limit_maxbytes  => 0,        # Total space allocated
    bytes           => 0,        # Total space used
    cmd_get         => 1000,     # Get commands
    cmd_set         => 1000,     # Set commands
);

# Display lifetime stats instead of per-second stats
$lifetime = 0;

# Display read/write bytes
$bytes = 1;

# Display get/set commands
$commands = 0;

# Show cumulative stats (since start of run)
$cumulative = 0;

# Default time to sleep in-between refreshes.
$sleep = 3;

# Run a single time as a one-off without formatting
$oneoff = 0;

# Connection timeout in seconds
$connect_timeout = 2;

# Sort by metric (empty = no sort, keeps original order)
$sort_by = '';

# Key to look up (empty = no lookup, monitor mode)
$get_key = '';

# Dump all keys
$dump_keys = 0;

# List of servers/ ports to query.
@default_instances = (
  '127.0.0.1:11211',
);

# Default port to connect to, if not specified
$default_port = "11211";

# END CONFIGURATION
################################################################################

@keys = ('usage', 'cache_hit', 'curr_connections', 'time', 'curr_items', 'cmd_get', 'cmd_set',
         'bytes_read', 'bytes_written', 'evictions', 'limit_maxbytes', 'bytes');

my @valid_sort_keys = ('usage', 'hit', 'conn', 'time', 'items', 'evict', 'gets', 'sets', 'read', 'write');

$help = 0;

if (@ARGV) {
  eval { require Getopt::Long; };
  if ($@) {
    if ( $ARGV[0] =~ /^\d+$/ ) {
      $sleep = $ARGV[0];
    }
    elsif ( $ARGV[0] eq '--help' || $ARGV[0] eq '-h' ) {
      show_help();
      exit 0;
    }
    else {
      die "USAGE: memcache-top <seconds to sleep>\nRun with --help for more information.\n";
    }
  }
  else {
    use Getopt::Long;
    GetOptions (
      'instances=s' => \@instances,
      'sleep=i'     => \$sleep,
      'port=i'      => \$default_port,
      'color!'      => \$usecolor,
      'lifetime!'   => \$lifetime,
      'bytes!'      => \$bytes,
      'commands!'   => \$commands,
      'cumulative!' => \$cumulative,
      'oneoff'      => \$oneoff,
      'sort=s'      => \$sort_by,
      'timeout=i'   => \$connect_timeout,
      'get=s'       => \$get_key,
      'dump'        => \$dump_keys,
      'help|h'      => \$help,
    );
    if ($help) {
      show_help();
      exit 0;
    }
    if (@instances) {
      @instances = split(/,/,join(',',@instances));
    } else {
      @instances = @default_instances;
    }
  }
}
else {
  @instances = @default_instances;
}

if ( $lifetime && $cumulative ) {
  $lifetime = 0;
}

# Validate sort option
if ( $sort_by && !grep { $_ eq $sort_by } @valid_sort_keys ) {
  die "Invalid sort key '$sort_by'. Valid options: " . join(', ', @valid_sort_keys) . "\n";
}

if ( $usecolor ) {
  eval { require Term::ANSIColor; };
  if ($@) { $usecolor = 0; }
  else { use Term::ANSIColor; }
}

if ( $oneoff ) {
  $usecolor = 0;
}

# Handle --get (key lookup) mode
if ( $get_key ) {
  cache_get(\@instances, $get_key);
  exit 0;
}

# Handle --dump (list all keys) mode
if ( $dump_keys ) {
  cache_dump_keys(\@instances);
  exit 0;
}

# Setup non-blocking keyboard input for interactive mode
my $interactive = 0;
unless ($oneoff) {
  eval {
    require POSIX;
    POSIX->import(':termios_noncanon');
  };
  if (!$@) {
    $interactive = 1;
  }
}

# Column widths for aligned output
my $col_instance = 24;
my $col_data     = 9;

my $i = 1;
my (%original);

while ($i) {

  @out = ();

  unless ($oneoff) { push @out, "\033[2J\033[H"; }  # Clear screen and move cursor to top

  # Header
  push @out, color 'bold' if $usecolor;
  push @out, "\n";
  push @out, " memcache-top v$version";
  push @out, color 'reset' if $usecolor;

  my $mode = "per-second";
  $mode = "lifetime" if $lifetime;
  $mode = "cumulative" if $cumulative;

  push @out, "  |  port: $default_port  |  refresh: ${sleep}s  |  mode: $mode";
  push @out, "  |  sort: $sort_by" if $sort_by;
  push @out, "\n";

  # Separator line
  my $total_width = $col_instance + ($col_data * 6);
  $total_width += ($col_data * 2) if $commands;
  $total_width += ($col_data * 2) if $bytes;
  my $sep = " " . ("-" x $total_width);
  push @out, $sep . "\n";

  # Column headers
  push @out, color 'bold' if $usecolor;
  push @out, sprintf(" %-${col_instance}s", "INSTANCE");
  push @out, sprintf("%${col_data}s", "USAGE");
  push @out, sprintf("%${col_data}s", "HIT %");
  push @out, sprintf("%${col_data}s", "CONN");
  push @out, sprintf("%${col_data}s", "TIME");
  push @out, sprintf("%${col_data}s", "ITEMS");
  if ( $lifetime || $cumulative ) {
    push @out, sprintf("%${col_data}s", "EVICT");
    if ($commands) {
      push @out, sprintf("%${col_data}s", "GETS");
      push @out, sprintf("%${col_data}s", "SETS");
    }
    if ($bytes) {
      push @out, sprintf("%${col_data}s", "READ");
      push @out, sprintf("%${col_data}s", "WRITE");
    }
  } else {
    push @out, sprintf("%${col_data}s", "EVICT/s");
    if ($commands) {
      push @out, sprintf("%${col_data}s", "GETS/s");
      push @out, sprintf("%${col_data}s", "SETS/s");
    }
    if ($bytes) {
      push @out, sprintf("%${col_data}s", "READ/s");
      push @out, sprintf("%${col_data}s", "WRITE/s");
    }
  }
  push @out, "\n";
  push @out, color 'reset' if $usecolor;
  push @out, $sep . "\n";

  my %tot;
  foreach my $key (@keys) {
    $tot{$key} = 0;
  }

  my $count = 0;
  my @instance_rows;  # For sorting support

  foreach my $instance (@instances) {

    my ($port, $server);

    my @split = split(/:/, $instance);
    unless ( $split[1] ) {
      $instance = $instance . ":" . $default_port;
      $port = $default_port;
    }
    else {
      $port = $split[1];
    }

    # Determine display name for the instance
    my $max_len = $col_instance - 1;
    if ( length($instance) > $max_len ) {
      if ( $port ne $default_port ) {
        $server = substr($split[0], 0, $max_len - length($port) - 1) . ":" . $port;
      }
      else {
        $server = substr($split[0], 0, $max_len);
      }
    }
    else {
      $server = $instance;
    }

    my $t0 = time();

    $remote = IO::Socket::INET->new(
      PeerAddr => $instance,
      Timeout  => $connect_timeout,
    );
    unless ( defined($remote) ) {
      push @out, color 'red' if $usecolor;
      push @out, sprintf(" %-${col_instance}s", $server);
      push @out, " DOWN - connection failed\n";
      push @out, color 'reset' if $usecolor;
      $count++;
      next;
    }

    $remote->autoflush(1);
    $count++;

    print $remote "stats\n";

    my (%stats, %outstats);

    foreach my $key (@keys) {
      $outstats{$key} = 0;
    }

    LINE: while ( defined ( my $line = <$remote> ) ) {
      last LINE if ( $line =~ /END/ );
      chomp $line;
      my @bits = split(' ', $line);
      next LINE unless defined $bits[1] && defined $bits[2];
      $stats{$bits[1]} = $bits[2];
      next LINE;
    }

    close $remote;

    my $t1 = time();
    $outstats{time} = ($t1 - $t0) * 1000;

    # Guard against division by zero
    my $cmd_get_safe = ($stats{cmd_get} || 1);

    if ( $lifetime || $cumulative) {
      foreach my $key ('cmd_get', 'cmd_set', 'get_hits', 'get_misses', 'evictions', 'bytes_read', 'bytes_written') {
        if ( $cumulative ) {
          if ( $i == 1 ) {
            $original{$instance}{$key} = $stats{$key};
          } else {
            $outstats{$key} = $stats{$key} - $original{$instance}{$key};
          }
        } else {
          $outstats{$key} = $stats{$key};
        }
      }
      $outstats{cache_hit} = ( $stats{get_hits} / $cmd_get_safe ) * 100;
    } else {
      foreach my $key ('cmd_get', 'cmd_set', 'get_hits', 'get_misses', 'evictions', 'bytes_read', 'bytes_written') {
        if ( defined ( $laststats{$instance}{$key} ) ) {
          $outstats{$key} = ($stats{$key} - $laststats{$instance}{$key}) / $sleep;
        }
      }
      $outstats{cache_hit} = 0;
      if ( defined($laststats{$instance}{cmd_get}) && $laststats{$instance}{cmd_get} > 0 ) {
        $outstats{cache_hit} = ( $laststats{$instance}{get_hits} / $laststats{$instance}{cmd_get} ) * 100;
      }
    }

    $outstats{limit_maxbytes} = $stats{limit_maxbytes} || 0;
    $outstats{bytes} = $stats{bytes} || 0;
    if ( $outstats{limit_maxbytes} > 0 ) {
      $outstats{usage} = ( $stats{bytes} / $stats{limit_maxbytes} * 100 );
    } else {
      $outstats{usage} = 0;
    }
    $outstats{curr_connections} = $stats{curr_connections} || 0;
    $outstats{curr_items} = $stats{curr_items} || 0;

    if ( $cumulative ) {
      foreach my $key ('cmd_get', 'cmd_set', 'get_hits', 'get_misses', 'evictions', 'bytes_read', 'bytes_written') {
        $threshold{$key} = $threshold{$key} * $i if $threshold{$key};
      }
    }

    # Build row data for this instance
    my @row_out;
    push @row_out, sprintf(" %-${col_instance}s", $server);
    push @row_out, format_stat($outstats{usage}, $threshold{usage}, 1, 0, '%', '%.1f');
    push @row_out, format_stat($outstats{cache_hit}, $threshold{cache_hit}, 0, 0, '%', '%.1f');
    push @row_out, format_stat($outstats{curr_connections}, $threshold{curr_connections}, 1, 0, '', '%.0d');
    if ( $outstats{time} >= 1000 ) {
      push @row_out, format_stat($outstats{time}/1000, $threshold{time}/1000, 1, 0, 's', '%.2f');
    } else {
      push @row_out, format_stat($outstats{time}, $threshold{time}, 1, 0, 'ms', '%.1f');
    }
    push @row_out, format_stat($outstats{curr_items}, $threshold{curr_items}, 1, 0, '', '%.0d');
    push @row_out, format_stat($outstats{evictions}, $threshold{evictions}, 1, 0, '', '%.1f');
    if ( $commands ) {
      push @row_out, format_stat($outstats{cmd_get}, $threshold{cmd_get}, 1, 0, '', '%.0f');
      push @row_out, format_stat($outstats{cmd_set}, $threshold{cmd_set}, 1, 0, '', '%.0f');
    }
    if ( $bytes ) {
      push @row_out, format_stat($outstats{bytes_read}, $threshold{bytes_read}, 1, 0, '', '%.0f');
      push @row_out, format_stat($outstats{bytes_written}, $threshold{bytes_written}, 1, 0, '', '%.0f');
    }

    push @instance_rows, { text => join('', @row_out), stats => {%outstats} };

    foreach my $key (@keys) {
      $tot{$key} = $tot{$key} + $outstats{$key};
    }

    unless ( $lifetime || $cumulative ) {
      foreach my $key ('cmd_get', 'cmd_set', 'get_hits', 'get_misses', 'evictions', 'bytes_read', 'bytes_written') {
        $laststats{$instance}{$key} = $stats{$key};
      }
    }

  }

  # Sort instances if requested
  if ($sort_by && @instance_rows) {
    my %sort_key_map = (
      'usage' => 'usage',
      'hit'   => 'cache_hit',
      'conn'  => 'curr_connections',
      'time'  => 'time',
      'items' => 'curr_items',
      'evict' => 'evictions',
      'gets'  => 'cmd_get',
      'sets'  => 'cmd_set',
      'read'  => 'bytes_read',
      'write' => 'bytes_written',
    );
    my $sk = $sort_key_map{$sort_by} || 'usage';
    @instance_rows = sort { $b->{stats}{$sk} <=> $a->{stats}{$sk} } @instance_rows;
  }

  # Output sorted instance rows
  foreach my $row (@instance_rows) {
    push @out, $row->{text} . "\n";
  }

  # Summary section
  if ($count > 0) {
    push @out, $sep . "\n";
    push @out, color 'bold' if $usecolor;

    # AVERAGE row
    push @out, sprintf(" %-${col_instance}s", "AVERAGE");
    push @out, format_stat($tot{usage}/$count, $threshold{usage}, 1, 1, '%', '%.1f');
    push @out, format_stat($tot{cache_hit}/$count, $threshold{cache_hit}, 0, 1, '%', '%.1f');
    push @out, format_stat($tot{curr_connections}/$count, $threshold{curr_connections}, 1, 1, '', '%.0d');
    if ( ( $tot{time}/$count ) >= 1000 ) {
      push @out, format_stat(($tot{time}/$count)/1000, $threshold{time}/1000, 1, 1, 's', '%.2f');
    } else {
      push @out, format_stat($tot{time}/$count, $threshold{time}, 1, 1, 'ms', '%.1f');
    }
    push @out, format_stat($tot{curr_items}/$count, $threshold{curr_items}, 1, 1, '', '%.0d');
    push @out, format_stat($tot{evictions}/$count, $threshold{evictions}, 1, 1, '', '%.1f');
    if ( $commands ) {
      push @out, format_stat($tot{cmd_get}/$count, $threshold{cmd_get}, 1, 1, '', '%.0f');
      push @out, format_stat($tot{cmd_set}/$count, $threshold{cmd_set}, 1, 1, '', '%.0f');
    }
    if ( $bytes ) {
      push @out, format_stat($tot{bytes_read}/$count, $threshold{bytes_read}, 1, 1, '', '%.0f');
      push @out, format_stat($tot{bytes_written}/$count, $threshold{bytes_written}, 1, 1, '', '%.0f');
    }
    push @out, "\n";

    # TOTAL row
    push @out, sprintf(" %-${col_instance}s", "TOTAL");
    push @out, format_stat($tot{bytes}, $threshold{bytes}, 0, 1, 'B/', '%.0f');
    push @out, format_stat($tot{limit_maxbytes}, $threshold{limit_maxbytes}, 0, 1, 'B', '%.0f');
    push @out, format_stat($tot{curr_connections}, $threshold{curr_connections}*$count, 1, 1, '', '%.0d');
    if ( $tot{time} >= 1000 ) {
      push @out, format_stat($tot{time}/1000, ($threshold{time}*$count)/1000, 1, 1, 's', '%.2f');
    } else {
      push @out, format_stat($tot{time}, $threshold{time}*$count, 1, 1, 'ms', '%.1f');
    }
    push @out, format_stat($tot{curr_items}, $threshold{curr_items}*$count, 1, 1, '', '%.0d');
    push @out, format_stat($tot{evictions}, $threshold{evictions}*$count, 1, 1, '', '%.1f');
    if ( $commands ) {
      push @out, format_stat($tot{cmd_get}, $threshold{cmd_get}*$count, 1, 1, '', '%.0f');
      push @out, format_stat($tot{cmd_set}, $threshold{cmd_set}*$count, 1, 1, '', '%.0f');
    }
    if ( $bytes ) {
      push @out, format_stat($tot{bytes_read}, $threshold{bytes_read}*$count, 1, 1, '', '%.0f');
      push @out, format_stat($tot{bytes_written}, $threshold{bytes_written}*$count, 1, 1, '', '%.0f');
    }
    push @out, color 'reset' if $usecolor;
    push @out, "\n";
  }

  unless ($oneoff) {
    push @out, "\n Press: ";
    push @out, color 'bold' if $usecolor;
    push @out, "q";
    push @out, color 'reset' if $usecolor;
    push @out, "=quit  ";
    push @out, color 'bold' if $usecolor;
    push @out, "c";
    push @out, color 'reset' if $usecolor;
    push @out, "=color  ";
    push @out, color 'bold' if $usecolor;
    push @out, "b";
    push @out, color 'reset' if $usecolor;
    push @out, "=bytes  ";
    push @out, color 'bold' if $usecolor;
    push @out, "g";
    push @out, color 'reset' if $usecolor;
    push @out, "=cmds  ";
    push @out, color 'bold' if $usecolor;
    push @out, "+/-";
    push @out, color 'reset' if $usecolor;
    push @out, "=interval  ";
    push @out, color 'bold' if $usecolor;
    push @out, "l";
    push @out, color 'reset' if $usecolor;
    push @out, "=lifetime  ";
    push @out, color 'bold' if $usecolor;
    push @out, "/";
    push @out, color 'reset' if $usecolor;
    push @out, "=search  ";
    push @out, color 'bold' if $usecolor;
    push @out, "d";
    push @out, color 'reset' if $usecolor;
    push @out, "=dump  ";
    push @out, color 'bold' if $usecolor;
    push @out, "h";
    push @out, color 'reset' if $usecolor;
    push @out, "=help\n";
  }

  print @out;

  # Handle keyboard input during sleep
  if (!$oneoff) {
    my $key = timed_read_key($sleep);
    if (defined $key) {
      if ($key eq 'q' || $key eq 'Q') {
        print "\n";
        exit 0;
      } elsif ($key eq 'c' || $key eq 'C') {
        $usecolor = !$usecolor;
        if ($usecolor) {
          eval { require Term::ANSIColor; };
          if ($@) { $usecolor = 0; }
        }
      } elsif ($key eq 'b' || $key eq 'B') {
        $bytes = !$bytes;
      } elsif ($key eq 'g' || $key eq 'G') {
        $commands = !$commands;
      } elsif ($key eq 'l' || $key eq 'L') {
        $lifetime = !$lifetime;
        $cumulative = 0 if $lifetime;
      } elsif ($key eq '+' || $key eq '=') {
        $sleep++ if $sleep < 60;
      } elsif ($key eq '-' || $key eq '_') {
        $sleep-- if $sleep > 1;
      } elsif ($key eq '/' || $key eq 's' || $key eq 'S') {
        interactive_search(\@instances);
      } elsif ($key eq 'd' || $key eq 'D') {
        interactive_dump(\@instances);
      } elsif ($key eq 'h' || $key eq 'H' || $key eq '?') {
        show_interactive_help();
      }
    }
  }

  $i++;

  if ($oneoff) { exit 0; }

}

################################################################################
# format_stat
# Formats a stat value with threshold coloring and proper column alignment.
#
sub format_stat {

  my ($stat, $threshold, $gt, $bold, $trail, $sprintf) = @_;

  my $result = '';
  my $color = 'red';
  my $offcolor = 'reset';
  if ( $bold ) {
    $color = 'bold red';
    $offcolor = 'reset bold';
  }

  my $colored = 0;
  if ( $gt ) {
    if ( $stat > $threshold ) { $colored = 1; }
  } else {
    if ( $stat < $threshold ) { $colored = 1; }
  }

  if ( $stat > 999999999999 ) {
    $stat = $stat / (1024*1024*1024*1024);
    $trail = 'T' . $trail;
    $sprintf = '%.1f';
  } elsif ( $stat > 99999999 ) {
    $stat = $stat / (1024*1024*1024);
    $trail = "G" . $trail;
    $sprintf = '%.1f';
  } elsif ( $stat > 999999 ) {
    $stat = $stat / (1024*1024);
    $trail = 'M' . $trail;
    $sprintf = '%.1f';
  } elsif ( $stat > 9999 ) {
    $stat = $stat/1024;
    $trail = 'K' . $trail;
    $sprintf = '%.1f';
  }

  my $formatted = sprintf($sprintf, $stat) . $trail;

  $result .= color $color if ($usecolor && $colored);
  $result .= sprintf("%${col_data}s", $formatted);
  $result .= color $offcolor if ($usecolor && $colored);

  return $result;
}

################################################################################
# timed_read_key
# Reads a single keypress with timeout. Returns the key or undef on timeout.
#
sub timed_read_key {
  my ($timeout) = @_;

  my $key;
  eval {
    # Try using Term::ReadKey if available
    eval { require Term::ReadKey; };
    if (!$@) {
      Term::ReadKey::ReadMode('cbreak');
      my $start = time();
      while (time() - $start < $timeout) {
        $key = Term::ReadKey::ReadKey(0.1);
        last if defined $key;
      }
      Term::ReadKey::ReadMode('restore');
    } else {
      # Fallback: use select() on STDIN
      my $rin = '';
      vec($rin, fileno(STDIN), 1) = 1;
      my $remaining = $timeout;
      my $start = time();
      while ($remaining > 0) {
        my $ready = select(my $rout = $rin, undef, undef, 0.1);
        if ($ready > 0) {
          # Set terminal to non-canonical mode
          system("stty -icanon -echo min 1 time 0 2>/dev/null");
          sysread(STDIN, $key, 1);
          system("stty icanon echo 2>/dev/null");
          last;
        }
        $remaining = $timeout - (time() - $start);
      }
      if (!defined $key) {
        # Just slept the timeout, no key pressed
      }
    }
  };
  if ($@) {
    # If keyboard reading fails, just sleep
    sleep($timeout);
  }

  return $key;
}

################################################################################
# show_help
# Displays the full help/usage message and exits.
#
sub show_help {
  print <<'HELP';

  memcache-top - real-time monitoring for memcached instances

  USAGE:
    memcache-top [OPTIONS]
    memcache-top <seconds>          (if Getopt::Long is not available)

  OPTIONS:
    -h, --help                 Show this help message
    --instances <host:port>    Memcached instances to monitor
                               (comma-separated or specify multiple times)
    --port <num>               Default port (default: 11211)
    --sleep <seconds>          Refresh interval (default: 3)
    --timeout <seconds>        Connection timeout (default: 2)
    --color / --nocolor        Enable/disable colored output (default: on)
    --lifetime / --nolifetime  Show lifetime stats vs per-second (default: off)
    --bytes / --nobytes        Show read/write bytes (default: on)
    --commands / --nocommands  Show get/set commands (default: off)
    --cumulative               Show cumulative stats since start
    --sort <key>               Sort instances by metric (descending)
                               Keys: usage, hit, conn, time, items,
                                     evict, gets, sets, read, write
    --get <key>                Look up a key and display its value
    --dump                     List all cached keys (then exit)
    --oneoff                   Run once without screen clearing

  INTERACTIVE KEYS (during monitoring):
    q       Quit
    c       Toggle color on/off
    b       Toggle bytes display
    g       Toggle get/set commands display
    l       Toggle lifetime stats
    +/-     Increase/decrease refresh interval
    / or s  Search: look up a key by name
    d       Dump: list all cached keys
    h, ?    Show interactive help

  EXAMPLES:
    memcache-top
    memcache-top --instances 10.0.0.1:11211,10.0.0.2:11211
    memcache-top --sleep 5 --commands --sort usage
    memcache-top --instances server1 --port 11211 --lifetime
    memcache-top --get session:abc123           (look up a key)
    memcache-top --dump                         (list all keys)
    memcache-top --oneoff --nocolor             (for scripting)

  THRESHOLDS:
    Values exceeding configured thresholds are highlighted in red.
    Edit the %threshold hash in the script to customize alert levels.

HELP
}

